Bootstrap: docker
From: ubuntu:26.04

%environment
    # Make conda available system-wide
    export PATH=/opt/conda/bin:$PATH

%post
    set -e

    echo "==> Installing system packages"
    apt-get update && apt-get install -y --no-install-recommends \
        wget \
        curl \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        ripgrep \
        tmux \
        git \
        unzip \
        rsync \
        file \
        tree \
        zsh \
        less \
        htop \
        fd-find \
        ncdu \
        ca-certificates \
        openssl \
        openssh-client \
        libopenexr-dev \
        libsm6 \
        libxext6 \
        libxrender1 \
        libxi6 \
        libgl1 \
        libglib2.0-0 \
        libssl-dev \
        libffi-dev \
        fzf \
        exuberant-ctags \
        software-properties-common \
        && rm -rf /var/lib/apt/lists/*

    echo "==> Installing Node.js LTS via NodeSource"
    curl -fsSL https://deb.nodesource.com/setup_lts.x | bash -
    apt-get install -y nodejs && rm -rf /var/lib/apt/lists/*

    echo "==> Installing Neovim (latest release >= 0.10)"
    curl -LO https://github.com/neovim/neovim/releases/latest/download/nvim-linux-x86_64.tar.gz
    tar -C /usr/local --strip-components=1 -xzf nvim-linux-x86_64.tar.gz
    rm nvim-linux-x86_64.tar.gz

    echo "==> Installing global npm packages (pyright, vscode langservers, tree-sitter)"
    npm install -g pyright vscode-langservers-extracted tree-sitter-cli

    echo "==> Installing Miniconda3 into /opt/conda"
    wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh \
        -O /tmp/miniconda.sh
    bash /tmp/miniconda.sh -b -p /opt/conda
    rm /tmp/miniconda.sh

    echo "==> Configuring conda"
    /opt/conda/bin/conda config --system --set auto_activate_base false
    /opt/conda/bin/conda clean -afy

    echo "==> Installing uv to /usr/local/bin"
    curl -LsSf https://astral.sh/uv/install.sh | \
        UV_INSTALL_DIR=/usr/local/bin sh

    echo "==> Installing Dust"
    wget https://github.com/bootandy/dust/releases/download/v1.2.4/du-dust_1.2.4-1_amd64.deb \
        -O /tmp/du-dust_1.2.4-1_amd64.deb 
    apt install -y /tmp/du-dust_1.2.4-1_amd64.deb 
    rm /tmp/du-dust_1.2.4-1_amd64.deb

    echo "==> Symlinking fdfind to fd"
    ln -s /usr/bin/fdfind /usr/local/bin/fd
